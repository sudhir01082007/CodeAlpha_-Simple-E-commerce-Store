# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (used by process.env.MONGODB_URI)
# - For Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/codealpha_ecommerce
#
# - For MongoDB Atlas Cloud Cluster:
#   Replace <username> and <password> with your Atlas Database User credentials:
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/codealpha_ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codealpha_ecommerce

# JSON Web Token Secret (used for signing and verifying user session tokens)
JWT_SECRET=your_jwt_secret_key_change_in_production
